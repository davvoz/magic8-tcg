{
  "name": "@magic8/engine",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic, side-effect-free rules engine shared by the authoritative server, the client and the replay verifier",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./testing/*": "./test/domain/engine/*",
    "./*": "./src/*"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info"
  }
}
