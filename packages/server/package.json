{
  "name": "@magic8/server",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative game server: modular monolith (identity, collection, marketplace, gameplay, chain)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "src/main.js",
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@magic8/engine": "0.1.0",
    "@magic8/protocol": "0.1.0",
    "@magic8/steem": "0.1.0",
    "pg": "8.23.0"
  },
  "scripts": {
    "start": "node src/main.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info"
  }
}
