{
  "name": "@magic8/steem",
  "version": "0.1.0",
  "private": true,
  "description": "STEEM adapter: account names, keys and signatures, JSON-RPC client with failover, implementations of the blockchain ports",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "dependencies": {
    "@magic8/engine": "0.1.0",
    "@magic8/protocol": "0.1.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info"
  }
}
