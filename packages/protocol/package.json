{
  "name": "@magic8/protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Game Blockchain Protocol: canonical JSON, hashing, hash-chained game events, commit-reveal, and the on-chain records of receipts, packs, trades and sales",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "dependencies": {
    "@magic8/engine": "0.1.0",
    "@noble/hashes": "2.4.0"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info"
  }
}
