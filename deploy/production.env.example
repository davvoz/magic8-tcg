# Copy to .env next to docker-compose.yml on the server, fill in, chmod 600.
# Never commit the real file. Variables: docs/tcg/07-runbook.md §1.

# Public domain (DNS pointing to this machine). The public origin is https://<M8_DOMAIN>.
M8_DOMAIN=play.example.com

# Port on 127.0.0.1 where the host's nginx finds the app (deploy/nginx.conf).
M8_HOST_PORT=8090

# Database password: hex only, it goes into a URL (openssl rand -hex 24).
POSTGRES_PASSWORD=

# Encrypts the secrets at rest (openssl rand -hex 32). Keep a copy OFF this machine, apart from the backups.
M8_DATA_KEY=

# WIF private key used only to sign acks; its public key goes into an ack_keys manifest.
M8_ACK_KEY=

# account:WIF_posting,... — posting keys only. Empty: nothing is published, records wait in the outbox.
M8_BROADCASTER_KEYS=

M8_SHOP_ACCOUNT=verdu.green
M8_ROOT_ACCOUNT=verdu.green
M8_ADMIN_ACCOUNTS=verdu.green

# Bearer token for /api/metrics (openssl rand -hex 32). Empty: no metrics endpoint.
M8_METRICS_TOKEN=

M8_LOG_LEVEL=info
